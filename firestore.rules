rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && userData().role == "Administrador";
    }
    function isSeller() {
      return signedIn() && userData().role == "Vendedor";
    }
    function fulfillmentStatus(status) {
      return status in ["Pendiente", "En preparación", "En camino", "Entregado", "Cancelado"];
    }
    function onlyStatusChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
    }
    function validProductPhoto(url) {
      return url is string && (url == "" || url.matches("https://.*"));
    }
    function canChangeOrderStatus() {
      return onlyStatusChanged() && (
        (resource.data.paymentStatus == "Aprobado" && fulfillmentStatus(request.resource.data.status))
        || (resource.data.paymentStatus != "Aprobado" && request.resource.data.status == "Cancelado")
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["fullName", "email", "phone", "role", "storeName"])
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && (
          (request.auth.uid == userId && request.resource.data.role == "Comprador")
          || (isAdmin() && request.resource.data.role in ["Comprador", "Vendedor"])
        );
      allow update: if signedIn()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["fullName", "phone", "storeName"])
        && (isAdmin() || request.auth.uid == userId);
      allow delete: if false;

      match /pets/{petId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(["name", "species", "breed", "ageLabel"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 80;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "sellerId", "storeName", "name", "description", "price", "category",
          "petType", "stock", "active", "photoUrl"
        ])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.active is bool
        && validProductPhoto(request.resource.data.photoUrl)
        && request.resource.data.sellerId is string
        && (
          (isSeller() && request.resource.data.sellerId == request.auth.uid)
          || isAdmin()
        );
      allow update: if signedIn()
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && validProductPhoto(request.resource.data.photoUrl)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "storeName", "name", "description", "price", "category", "petType",
          "stock", "active", "photoUrl"
        ])
        && (
          (isSeller() && resource.data.sellerId == request.auth.uid)
          || isAdmin()
        );
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.buyerId == request.auth.uid
        || request.auth.uid in resource.data.sellerIds
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "buyerId", "buyerName", "buyerEmail", "dateLabel", "createdAt", "status",
          "paymentStatus", "paymentRef", "address", "latitude", "longitude",
          "paymentMethod", "currency", "clientRequestId", "sellerIds", "subtotal",
          "total", "lines"
        ])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == "Pendiente"
        && request.resource.data.paymentStatus == "Pendiente de pago"
        && request.resource.data.paymentRef == ""
        && request.resource.data.currency == "COP"
        && request.resource.data.subtotal == request.resource.data.total
        && request.resource.data.total is number
        && request.resource.data.sellerIds is list
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 40;
      allow update: if (isSeller() && request.auth.uid in resource.data.sellerIds && canChangeOrderStatus())
        || (isAdmin() && canChangeOrderStatus());
      allow delete: if false;
    }

    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /lines/{lineId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "productId", "sellerId", "storeName", "name", "price", "quantity", "photoUrl"
          ])
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.quantity <= 100000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
