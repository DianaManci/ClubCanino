# Copia este archivo a backend/.env y completa los valores en tu máquina.
# backend/.env no se sube a Git. No pegues estas llaves en la app Android.
PORT=8787
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
# El servidor solo abre sesiones de prueba. false no habilita cobros reales.
EPAYCO_TEST=true
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
