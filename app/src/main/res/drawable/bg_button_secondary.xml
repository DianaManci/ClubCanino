<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_primary_disabled" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_pressed" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/green_primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/green_primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
