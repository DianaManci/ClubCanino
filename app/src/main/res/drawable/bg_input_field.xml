<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cream_surface" />
            <stroke
                android:width="@dimen/input_stroke_width_focused"
                android:color="@color/input_stroke_focused" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cream_surface_variant" />
            <stroke
                android:width="@dimen/input_stroke_width"
                android:color="@color/outline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cream_surface" />
            <stroke
                android:width="@dimen/input_stroke_width"
                android:color="@color/input_stroke" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
