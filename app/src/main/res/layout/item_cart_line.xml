<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:contentPadding="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_buyer_image_round"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imageProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_product_image"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_product_food" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/buyer_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Producto" />

                <TextView
                    android:id="@+id/textUnitPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/buyer_text_muted"
                    android:textSize="12sp"
                    tools:text="Unitario" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMinus"
                style="@style/Widget.ClubCanino.Button.Secondary"
                android:layout_width="@dimen/button_height_small"
                android:layout_height="@dimen/button_height_small"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/buyer_forest"
                android:textSize="@dimen/text_title"
                app:backgroundTint="@color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/buyer_forest" />

            <TextView
                android:id="@+id/textQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:gravity="center"
                android:minWidth="@dimen/icon_size_lg"
                android:textColor="@color/buyer_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlus"
                style="@style/Widget.ClubCanino.Button.Secondary"
                android:layout_width="@dimen/button_height_small"
                android:layout_height="@dimen/button_height_small"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/buyer_forest"
                android:textSize="@dimen/text_title"
                app:backgroundTint="@color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/buyer_forest" />

            <TextView
                android:id="@+id/textLineTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/buyer_forest"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="$ 0" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRemove"
            style="@style/Widget.ClubCanino.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/action_remove_from_cart"
            android:textAllCaps="false"
            android:textColor="@color/error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
