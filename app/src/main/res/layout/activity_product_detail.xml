<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/detailRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/spacing_xl">

        <ImageButton
            android:id="@+id/buttonNavigateBack"
            android:layout_width="@dimen/button_height_small"
            android:layout_height="@dimen/button_height_small"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_navigate_back"
            android:padding="@dimen/spacing_xs"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/green_primary" />

        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_image_detail"
            android:background="@drawable/bg_surface_rounded">

            <ImageView
                android:id="@+id/imageProduct"
                android:layout_width="@dimen/splash_logo_size"
                android:layout_height="@dimen/splash_logo_size"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_product_image"
                tools:src="@drawable/ic_pet_dog" />
        </FrameLayout>

        <TextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:textAppearance="@style/TextAppearance.ClubCanino.Headline"
            tools:text="Producto" />

        <TextView
            android:id="@+id/textMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.ClubCanino.Caption"
            tools:text="Perros · Alimentos" />

        <TextView
            android:id="@+id/textPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.ClubCanino.Title"
            android:textColor="@color/green_primary"
            tools:text="$ 0" />

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:textAppearance="@style/TextAppearance.ClubCanino.Body"
            tools:text="Descripción" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/label_quantity"
            android:textAppearance="@style/TextAppearance.ClubCanino.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMinus"
                style="@style/Widget.ClubCanino.Button.Secondary"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:minWidth="0dp"
                android:text="-"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/textQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:minWidth="@dimen/icon_size_xl"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ClubCanino.Headline"
                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlus"
                style="@style/Widget.ClubCanino.Button.Secondary"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:minWidth="0dp"
                android:text="+"
                android:textSize="@dimen/text_title" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddToCart"
            style="@style/Widget.ClubCanino.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/action_add_to_cart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.ClubCanino.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/action_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
