<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyer_cream"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/buyer_forest"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/buttonNavigateBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_navigate_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buyer_brand_tagline"
                android:textColor="#E8FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_paw"
            android:tint="@color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/detailRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_xl">

            <FrameLayout
                android:id="@+id/imageContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/buyer_detail_image"
                android:background="@drawable/bg_buyer_image_round"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imageProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_product_image"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_product_food" />
            </FrameLayout>

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:textColor="@color/buyer_text"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Producto" />

            <TextView
                android:id="@+id/textMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/buyer_text_muted"
                android:textSize="14sp"
                tools:text="Perros · Alimentos" />

            <TextView
                android:id="@+id/textPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/buyer_forest"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="$ 0" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:contentPadding="14dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/textDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/buyer_text"
                    android:textSize="15sp"
                    tools:text="Descripción" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/label_quantity"
                android:textColor="@color/buyer_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonMinus"
                    style="@style/Widget.ClubCanino.Button.Secondary"
                    android:layout_width="@dimen/button_height"
                    android:layout_height="@dimen/button_height"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="-"
                    android:textColor="@color/buyer_forest"
                    android:textSize="@dimen/text_title"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/buyer_forest" />

                <TextView
                    android:id="@+id/textQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_lg"
                    android:gravity="center"
                    android:minWidth="@dimen/icon_size_xl"
                    android:textColor="@color/buyer_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPlus"
                    style="@style/Widget.ClubCanino.Button.Secondary"
                    android:layout_width="@dimen/button_height"
                    android:layout_height="@dimen/button_height"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textColor="@color/buyer_forest"
                    android:textSize="@dimen/text_title"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/buyer_forest" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAddToCart"
                style="@style/Widget.ClubCanino.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/action_add_to_cart"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/buyer_forest"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.ClubCanino.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/action_back"
                android:textAllCaps="false"
                android:textColor="@color/buyer_forest" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
