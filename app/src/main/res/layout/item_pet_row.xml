<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ClubCanino.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ClubCanino.Label"
            tools:text="Luna" />

        <TextView
            android:id="@+id/textPetDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.ClubCanino.Caption"
            tools:text="Perro · Labrador · 3 años" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditPet"
                style="@style/Widget.ClubCanino.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height_small"
                android:text="@string/action_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeletePet"
                style="@style/Widget.ClubCanino.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height_small"
                android:text="@string/action_delete"
                android:textColor="@color/error" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
