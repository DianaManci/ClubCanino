<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:contentPadding="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_buyer_avatar">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_paw"
                    android:tint="@color/buyer_forest" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textOrderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/buyer_text"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    tools:text="#1006" />

                <TextView
                    android:id="@+id/textOrderMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/buyer_text_muted"
                    android:textSize="@dimen/text_caption"
                    tools:text="Ana Torres · 3 ítems" />
            </LinearLayout>

            <TextView
                android:id="@+id/textOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="3dp"
                android:textSize="@dimen/text_tiny"
                android:textStyle="bold"
                tools:text="En camino" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textOrderTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/buyer_forest"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                tools:text="$ 129.900" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewOrder"
                style="@style/Widget.ClubCanino.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height_small"
                android:text="@string/action_view_order"
                android:textAllCaps="false"
                android:textColor="@color/buyer_forest" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
